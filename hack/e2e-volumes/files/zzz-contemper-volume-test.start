#!/bin/sh
# hack/e2e-volumes.sh's OpenRC integration: the actual check is
# check-volume.sh (shared with the systemd integration), copied
# alongside this file into the image by hack/e2e-volumes/Containerfile;
# this script is only the OpenRC-specific part - running it as a
# local.d script.
#
# The "zzz-" filename prefix sorts after examples/alpine's own
# contemper.start in OpenRC's local.d run order (the same trick
# hack/e2e-variants/files/openrc-local.start uses), so
# hack/e2e-volumes.sh can rely on contemper-boot-ok always having been
# printed first.
exec /usr/local/lib/contemper/e2e-check-volume
