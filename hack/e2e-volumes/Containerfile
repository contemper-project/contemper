# Derived from either contemper-ready example (hack/e2e-volumes.sh picks
# which with --example alpine|debian, passing it in as BASE_IMAGE; this
# Containerfile is never built standalone) purely to declare two volumes
# and add a boot-time check for them, so the examples themselves stay
# volume-free and the plain e2e tests never need the volume helper. See
# hack/e2e-volumes.sh.
#
# The boot check itself (files/check-volume.sh) is shared between init
# systems; only its two thin integrations differ -
# files/zzz-contemper-volume-test.start for OpenRC,
# files/contemper-volume-test.service for systemd. Both are copied into
# every derived image regardless of which example it's built from:
# whichever one the base image's init system can't run is simply never
# read.
ARG BASE_IMAGE=contemper-example:dev
FROM ${BASE_IMAGE}

# /data seeds normally: a blank volume disk is formatted and then
# copied onto from this seed.txt, baked in before the disk ever exists.
# Ownership and mode (of the file and of /data itself) are set to
# something other than mkfs.ext4's own root:root 0755 default, so a
# correct seed can be told apart from one that merely created an empty
# directory.
LABEL io.contemper.volume./data.size="64MiB"
RUN mkdir -p /data && \
    printf 'contemper-e2e-seed\n' >/data/seed.txt && \
    chown 1000:1000 /data /data/seed.txt && \
    chmod 750 /data && \
    chmod 640 /data/seed.txt
VOLUME /data

# /data-noseed opts out of seeding with its own label: it bakes in a
# seed file the same way, which must never appear on the mounted
# volume once it's formatted.
LABEL io.contemper.volume./data-noseed.size="16MiB"
LABEL io.contemper.volume./data-noseed.seed="false"
RUN mkdir -p /data-noseed && printf 'contemper-e2e-noseed\n' >/data-noseed/seed.txt
VOLUME /data-noseed

# Changed between the two builds hack/e2e-volumes.sh makes (REVISION=1,
# then REVISION=2 for the "deploy an image update" check), so the two
# images differ by more than just their tag.
ARG REVISION=1
RUN echo "revision=${REVISION}" >/etc/contemper-e2e-volumes-revision

COPY files/check-volume.sh /usr/local/lib/contemper/e2e-check-volume
RUN chmod +x /usr/local/lib/contemper/e2e-check-volume

# OpenRC integration: inert if this base has no OpenRC.
COPY files/zzz-contemper-volume-test.start /etc/local.d/zzz-contemper-volume-test.start
RUN chmod +x /etc/local.d/zzz-contemper-volume-test.start

# systemd integration: inert if this base has no systemd. Enabled with a
# pre-created .wants symlink, same as support/volumes-support/systemd and
# examples/debian's own boot marker - fine to create at build time since
# this runs inside the image build, never at boot.
COPY files/contemper-volume-test.service /etc/systemd/system/contemper-volume-test.service
RUN mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf ../contemper-volume-test.service /etc/systemd/system/multi-user.target.wants/contemper-volume-test.service
