#!/bin/sh
# contemper-volumes generator: restores the mount ordering that nofail
# takes away from a declared volume's fstab mount unit.
#
# contemper appends "LABEL=<name> <mountpoint> ext4 defaults,nofail 0 2"
# to /etc/fstab for every declared volume (docs/guide/volumes.md).
# nofail exists so a missing or not-yet-formatted disk only delays boot
# rather than failing it, but on systemd nofail also removes the
# generated mount unit's implicit Before=local-fs.target ordering
# (systemd.mount(5), "nofail"): the unit stays only Wants=-ed by
# local-fs.target, so local-fs.target - and therefore every ordinary
# service, which is ordered After=local-fs.target by default - can be
# reached before the volume is mounted. A service can then start and
# write into the mount point on the *root* filesystem, underneath where
# the volume will later be mounted.
#
# This generator writes back just the missing ordering, for every
# declared volume, as a drop-in on its mount unit:
#
#   [Unit]
#   Before=local-fs.target
#
# It deliberately leaves everything else about nofail alone - no
# Requires=, no dropping nofail from fstab - so a missing or broken disk
# still only delays boot by the device's own timeout
# (x-systemd.device-timeout, 90s by default) and then continues exactly
# as nofail promises; this only makes local-fs.target, and so every
# service ordered after it, wait for that outcome instead of racing it.
#
# Invoked by systemd as a generator (systemd.generator(7)):
# "contemper-volumes <normal-dir> <early-dir> <late-dir>". Reads
# /etc/contemper/volumes - one line per declared volume, "name
# serial-pattern fs mountpoint" (mount point last, since it may contain
# spaces), read with `read -r`, never sourced; see
# ../../../base/usr/lib/contemper/format-volumes for the exact format,
# which this script follows the same way. For each volume, the mount
# unit name is computed with `systemd-escape --path --suffix=mount
# <mountpoint>` and a drop-in is written to
# <normal-dir>/<unit>.d/contemper-volumes.conf.
#
# Generators run very early in boot, often against a still read-only
# root, and must never fail it: every problem here - no volumes file, no
# systemd-escape, an unwritable output directory, a line that doesn't
# escape - is skipped silently and this script always exits 0.
# Generators must not write to stdout (systemd.generator(7)); this
# script never does, and logs nothing to stderr either, since even that
# lands in the journal/kmsg for what is expected to be the common case
# (no volumes, or nothing left to do).
#
# CONTEMPER_VOLUMES_FILE overrides the volumes file path; only tests use
# this.
#
# POSIX sh, meant to be shellcheck -s sh clean. Identical across every
# image that carries it; only this systemd variant needs it, since
# OpenRC's localmount already mounts every fstab entry before starting
# any service.
set -u

VOLUMES_FILE=${CONTEMPER_VOLUMES_FILE:-/etc/contemper/volumes}
PROG=contemper-volumes

normal_dir=${1:-}

[ -n "$normal_dir" ] || exit 0
[ -f "$VOLUMES_FILE" ] || exit 0
command -v systemd-escape >/dev/null 2>&1 || exit 0

# Only vol_name (to detect a blank line, the same way format-volumes
# does) and vol_mount matter here - the serial pattern and filesystem
# are format-volumes' concern, not this generator's - so both middle
# fields read into the same throwaway variable.
while IFS=' ' read -r vol_name _ _ vol_mount; do
	[ -n "$vol_name" ] || continue
	[ -n "$vol_mount" ] || continue

	unit=$(systemd-escape --path --suffix=mount "$vol_mount" 2>/dev/null) || continue
	[ -n "$unit" ] || continue

	dropin_dir="$normal_dir/$unit.d"
	mkdir -p "$dropin_dir" 2>/dev/null || continue

	cat >"$dropin_dir/contemper-volumes.conf" <<-EOF 2>/dev/null || continue
	# Generated by $PROG: restores the Before=local-fs.target ordering
	# nofail removes from this fstab-generated mount unit, so
	# local-fs.target - and every ordinary service after it - waits for
	# $vol_mount to be mounted, or its device to time out, before
	# continuing.
	[Unit]
	Before=local-fs.target
	EOF
done <"$VOLUMES_FILE"

exit 0
