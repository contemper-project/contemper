# contemper-volumes: prepares declared volumes (reuse an already-
# formatted one, format a blank one, leave anything else alone) before
# local filesystems are checked and mounted. The actual logic is
# /usr/lib/contemper/format-volumes, from the base volume-formatting
# support image; this unit is only the systemd integration that runs it
# at the right point in boot - the counterpart of
# ../../../openrc/etc/init.d/contemper-volumes.
#
# Ordering:
#  - DefaultDependencies=no: this needs to run ahead of the normal
#    sysinit.target-relative position a service gets by default, the
#    same reason local-fs-pre.target itself sets it.
#  - After=systemd-udev-trigger.service: by the time udev-trigger's own
#    oneshot has run, systemd-udevd is already active and every device
#    already present in sysfs - which on a VM means every attached disk,
#    root and volumes alike, since every target hands them all over
#    upfront rather than hot-plugging - has had its "coldplug" uevent
#    replayed for udev to process, without waiting on the (deprecated)
#    full `udevadm settle`.
#  - Before=local-fs-pre.target: every fstab-generated mount unit,
#    including a volume's LABEL=<name> one, is implicitly
#    After=local-fs-pre.target, so this always runs first.
#
# Finding a disk by serial (see format-volumes) reads /sys/block/*/serial
# directly, a sysfs attribute the kernel populates at device-probe time,
# so device discovery here needs no udev involvement at all. Formatting
# a blank disk (mkfs.ext4 -F) does rely on udev to make the resulting
# label visible as /dev/disk/by-label/<name>, and not just on udev being
# active: udev's own relabelling of a freshly-written disk normally comes
# from the "watch" rule in 60-block.rules, an inotify watch on the block
# device that fires a synthetic "change" uevent when a writer (mkfs.ext4
# included) closes it - the kernel itself raises no such event on close.
# That watch is only armed once udev has processed the device's own
# add/change event, and udev-trigger having run only guarantees those
# events were queued, not that udev finished processing them before this
# unit's ExecStart runs. So format-volumes cannot rely on the watch
# existing yet; instead format-volumes itself explicitly runs `udevadm
# trigger --action=change` (and `udevadm settle`) right after a
# successful mkfs.ext4, rather than depending on this unit's ordering to
# guarantee it indirectly. The LABEL=<name> mount unit systemd generates
# from fstab is bound to the resulting udev-created device unit rather
# than attempted once and given up on, so it simply waits for the label
# to appear once format-volumes has triggered it.
[Unit]
Description=contemper: prepare declared volumes
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-udev-trigger.service
Before=local-fs-pre.target shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/contemper/format-volumes

[Install]
WantedBy=local-fs-pre.target
