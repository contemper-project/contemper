#!/bin/sh
# contemper-format-volumes: first-boot (and every-boot) volume
# preparation. Reads /etc/contemper/volumes, a data file with one line
# per declared volume ("name serial-pattern fs mountpoint", mount point
# last since it may contain spaces), and for each volume's disk - found
# by matching /sys/block/*/serial against the serial pattern - applies
# one rule:
#
#   - an ext4 filesystem already carrying the expected label is REUSED
#     as-is (this is what lets a new image version run on the data a
#     previous version left behind);
#   - a disk whose first and last MiB are all zero is BLANK and gets
#     formatted (mkfs.ext4, labelled with the volume's name) and then,
#     unless the volume opted out (see NOSEED_FILE below), SEEDED: if the
#     image itself has content at the volume's mount point, that content
#     is copied onto the freshly formatted disk before it is ever
#     mounted there, the same way Docker seeds a new named volume from
#     the image - without seeding, that content would simply be hidden
#     under the empty mount once fstab mounts the volume over it;
#   - anything else is LEFT ALONE and logged as a mismatch, so the
#     failure mode is an unformatted, unmounted volume, never lost data.
#
# Mounting itself is left to the ordinary fstab-driven mount step (the
# LABEL=<name> lines contemper appends to /etc/fstab): this script only
# makes sure the filesystem those lines expect is present, correctly
# labelled, and (for a newly formatted volume) seeded before that mount
# step runs - while the image's own content at the mount point is still
# what's there to see, since nothing has been mounted over it yet.
#
# POSIX sh, and meant to be shellcheck-clean. /etc/contemper/volumes, and
# the optional /etc/contemper/volumes-noseed (NOSEED_FILE: one opted-out
# volume *name* per line, missing entirely when nothing opts out), are
# both read line by line with `read`, never sourced. Never fails the
# boot: every problem is logged (to the console, and to syslog if a
# logger is available) and skipped, and the script always exits 0 -
# seeding included, so a seeding failure leaves the volume formatted and
# empty rather than stopping the machine from booting.
#
# Identical across every image; only the per-init-system integration
# that calls it (an OpenRC init script, a systemd unit) differs, and that
# lives in the helper's variant images, not here.
set -u

VOLUMES_FILE=/etc/contemper/volumes
NOSEED_FILE=/etc/contemper/volumes-noseed
PROG=contemper-volumes

log() {
	msg="$PROG: $*"
	echo "$msg" >/dev/console 2>/dev/null || true
	if command -v logger >/dev/null 2>&1; then
		logger -t "$PROG" "$*" 2>/dev/null || true
	fi
}

# find_device prints the block device name (e.g. "vda") whose
# /sys/block/*/serial equals $1, or nothing if none matches.
find_device() {
	pattern=$1
	for serial_file in /sys/block/*/serial; do
		[ -e "$serial_file" ] || continue
		serial=$(cat "$serial_file" 2>/dev/null)
		if [ "$serial" = "$pattern" ]; then
			basename "$(dirname "$serial_file")"
			return 0
		fi
	done
	return 1
}

# device_size_bytes prints the size in bytes of the whole-disk block
# device named $1 (e.g. "vda"), read from sysfs (always present for a
# block device, so this needs no extra host tool beyond what's already
# required).
device_size_bytes() {
	devname=$1
	sectors=$(cat "/sys/block/$devname/size" 2>/dev/null) || return 1
	[ -n "$sectors" ] || return 1
	echo $((sectors * 512))
}

# chunk_is_zero tests whether the $3 bytes of device $1 starting at
# MiB offset $2 can be read in full and are all zero. It needs no
# temporary files: when it runs, the root filesystem is usually still
# read-only. A short or failed read counts as "not zero", so an
# unreadable disk is never mistaken for a blank one. od collapses
# repeated lines into "*", which is safe to drop: a repeated line is
# identical to the line printed before it.
chunk_is_zero() {
	got=$(dd if="$1" bs="$3" skip="$2" count=1 2>/dev/null | wc -c)
	[ "$got" -eq "$3" ] || return 1
	nonzero=$(dd if="$1" bs="$3" skip="$2" count=1 2>/dev/null | od -An -tx1 | tr -d ' \n0*')
	[ -z "$nonzero" ]
}

# is_blank tests whether device $1, of size $2 bytes, has its first and
# last MiB all zero (the whole device, if it is smaller than a MiB).
is_blank() {
	mib=1048576
	if [ "$2" -lt "$mib" ]; then
		chunk_is_zero "$1" 0 "$2"
		return
	fi
	chunk_is_zero "$1" 0 "$mib" || return 1
	chunk_is_zero "$1" $((($2 - mib) / mib)) "$mib"
}

# ext4_label reads device $1's ext2/3/4 superblock directly and prints
# its volume label, or nothing (and fails) if $1 doesn't start with a
# valid ext2/3/4 superblock. This deliberately avoids e2label (and
# tune2fs, dumpe2fs): those ship in e2fsprogs-extra, not the base
# e2fsprogs package, so an image that installs only e2fsprogs for
# mkfs.ext4 - Alpine's does exactly this - would not have them. dd and
# od (with wc and tr) are what busybox and coreutils both
# always install.
#
# The ext2/3/4 superblock starts at byte 1024. s_magic, a little-endian
# 16-bit value at offset 1024+56, must read 0xEF53 for this to be an
# ext2/3/4 filesystem at all. s_volume_name, 16 bytes at offset 1024+120,
# is NUL-padded ASCII; capturing it through command substitution
# truncates at the first NUL the same way a C string would, so a short
# label comes back exactly as mkfs.ext4 -L stored it, and a full
# 16-byte label (no NUL byte at all) comes back whole.
#
# dd extracts the exact byte ranges (busybox and GNU dd agree on
# if/bs/skip/count); od turns the bytes into hex two digits at a time
# ("od -An -tx1" is supported by both busybox and GNU od, unlike -j/-N
# skip/count options or GNU-only decoding tricks); printf's own
# "0x.."-prefixed numeric-argument handling (POSIX-specified, unlike
# "$((16#..))" arithmetic base conversion) turns each hex byte into an
# octal escape, and printf '%b' decodes those back into raw bytes -
# everything past od is POSIX parameter expansion and printf, so no
# other tool is required.
ext4_label() {
	dev=$1

	magic=$(dd if="$dev" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \t\n')
	[ "$magic" = "53ef" ] || return 1

	hex=$(dd if="$dev" bs=1 skip=1144 count=16 2>/dev/null | od -An -tx1 | tr -d ' \t\n')

	label=
	rest=$hex
	while [ -n "$rest" ]; do
		byte=${rest%"${rest#??}"}
		rest=${rest#??}
		label="$label\\$(printf '%03o' "0x$byte")"
	done
	printf '%b' "$label"
}

# reprobe_disk asks udev to re-probe device $1, just labelled $2 by
# mkfs.ext4, so /dev/disk/by-label/$2 exists before this script returns
# instead of depending on udev's own doing so on its own schedule. udev
# normally relabels a freshly formatted disk through the "watch" rule in
# 60-block.rules (OPTIONS+="watch"), which arms an inotify watch on the
# block device and fires a synthetic "change" uevent when a writer -
# mkfs.ext4 included - closes it; the kernel itself raises no such event
# on close. That watch is only armed once udev has processed the
# device's own add/change event, and systemd-udev-trigger.service (see
# the comment on After= in the systemd unit) only guarantees those
# events were queued before this script runs, not that udev finished
# processing them. So a coldplug race is possible: mkfs.ext4 can close
# the device before the watch exists, no change event ever fires, and
# /dev/disk/by-label/$2 never appears - the failure this function exists
# to close by re-probing explicitly instead of relying on that race.
#
# Without udevadm - Alpine ships mdev, not udev, so there's nothing to
# trigger - this is a no-op: OpenRC's localmount mounts by LABEL through
# blkid at mount time, never through a udev-created symlink, so no
# by-label device is needed there in the first place (confirmed by the
# Alpine e2e boot passing with no udevadm on PATH at all).
#
# Never fails the boot: any udevadm error is logged and ignored, and
# this always returns 0.
reprobe_disk() {
	dev=$1
	label=$2
	command -v udevadm >/dev/null 2>&1 || return 0
	if ! out=$(udevadm trigger --action=change "$dev" 2>&1); then
		log "volume $label: udevadm trigger --action=change $dev failed: $out"
	fi
	if ! out=$(udevadm settle --timeout=10 --exit-if-exists="/dev/disk/by-label/$label" 2>&1); then
		log "volume $label: udevadm settle for $label failed: $out"
	fi
	return 0
}

# noseed_contains reports whether $NOSEED_FILE lists volume name $1,
# opting it out of seed_volume below. A missing NOSEED_FILE means
# nothing is opted out (convert only ever writes it when at least one
# volume is); an existing but empty one means the same thing, since an
# empty file obviously lists no names either way - convert never writes
# one of those in the first place, but a hand-edited image could, and
# this treats it exactly like a missing file rather than as an error.
noseed_contains() {
	name=$1
	[ -f "$NOSEED_FILE" ] || return 1
	# "|| [ -n ... ]" still checks a last line with no trailing newline.
	while IFS= read -r line || [ -n "$line" ]; do
		[ "$line" = "$name" ] && return 0
	done <"$NOSEED_FILE"
	return 1
}

# seed_volume prepares device $1, just formatted blank and labelled $3,
# from the image's own directory at mount point $2, before fstab mounts
# the (otherwise empty) volume over it: it copies that directory's
# content onto the new filesystem, and gives the filesystem's root
# directory the directory's own owner and mode - the latter even when
# the directory is empty, so an image that only prepares an empty,
# non-root-owned mount point still hands its service a volume it can
# write to. It is called once, right after a successful mkfs.ext4, and
# only when the volume isn't listed in $NOSEED_FILE. If $2 doesn't exist
# (or isn't a directory) there is nothing to take over and this does
# nothing.
#
# The device can't simply be mounted at $2 itself to copy in place: $2
# is a path in the *root* filesystem, which at this point in boot is
# commonly still read-only, and is in any case not where the new
# filesystem lives yet. Instead this mounts $1 at a fresh directory
# under /run (a writable tmpfs on every image this helper targets) just
# long enough to copy into it, then unmounts and removes it again; $2
# itself is never written to. $2 is always read through "$2/.", so a
# mount point that is a symlink to a directory is handled like that
# directory (the same directory fstab's mount will end up on).
#
# cp -a is what both busybox and GNU coreutils provide for "copy
# everything, preserving as much as possible" (mode, ownership,
# timestamps, symlinks and special files; GNU cp also carries xattrs
# where it can, busybox doesn't). "$2/." as the source copies the
# directory's *content*, dotfiles included, into the destination
# directory rather than creating a subdirectory there. The copy does not
# stop at mount points below $2, but nothing is mounted there yet at
# this point in boot. The root directory's owner and mode are applied
# separately afterwards with `stat -c`, when one is on PATH (optional:
# without it the root directory keeps mkfs.ext4's root-owned 0755).
#
# Never fails the boot: every problem - no /run, a mount failure, a copy
# that fails part-way (no space left on the volume, say) - is logged,
# and the already-formatted, already-labelled volume is left as it is
# for fstab to mount: empty, or holding whatever was copied before the
# failure. A seeded volume is never seeded again (a later boot finds it
# labelled and reuses it), so a failed copy is not retried. Exactly one
# log line reports each volume's outcome.
seed_volume() {
	dev=$1
	mnt=$2
	name=$3

	[ -d "$mnt" ] || return 0

	has_content=0
	for entry in "$mnt"/* "$mnt"/.[!.]* "$mnt"/..?*; do
		if [ -e "$entry" ] || [ -L "$entry" ]; then
			has_content=1
			break
		fi
	done

	if ! tmp=$(mktemp -d /run/contemper-volume-seed.XXXXXX 2>&1) || [ ! -d "$tmp" ]; then
		log "volume $name: could not create a temporary mount point under /run to seed $dev from $mnt, leaving it empty: $tmp"
		return 0
	fi

	if ! mount_out=$(mount -t ext4 "$dev" "$tmp" 2>&1); then
		log "volume $name: could not mount $dev at $tmp to seed it from $mnt, leaving it empty: $mount_out"
		rmdir "$tmp" 2>/dev/null || true
		return 0
	fi

	copy_ok=1
	copy_out=
	if [ "$has_content" -eq 1 ] && ! copy_out=$(cp -a "$mnt"/. "$tmp"/ 2>&1); then
		copy_ok=0
	fi

	# chown before chmod: chown may clear set-id bits, chmod then sets
	# exactly the mode the image's directory has.
	if command -v stat >/dev/null 2>&1 && attrs=$(stat -c '%u %g %a' "$mnt"/. 2>/dev/null); then
		uid=${attrs%% *}
		attr_rest=${attrs#* }
		gid=${attr_rest%% *}
		mode=${attr_rest#* }
		chown "$uid:$gid" "$tmp" 2>/dev/null || true
		chmod "$mode" "$tmp" 2>/dev/null || true
	fi

	umount_note=
	if umount_out=$(umount "$tmp" 2>&1); then
		rmdir "$tmp" 2>/dev/null || true
	else
		umount_note=" (could not unmount $tmp afterwards: $umount_out)"
	fi

	if [ "$copy_ok" -eq 0 ]; then
		log "volume $name: seeding $dev from $mnt failed part-way, the volume keeps whatever was copied: $copy_out$umount_note"
	elif [ "$has_content" -eq 1 ]; then
		log "volume $name: seeded $dev from $mnt$umount_note"
	else
		log "volume $name: $mnt is empty in the image, nothing to seed onto $dev beyond its owner and mode$umount_note"
	fi
	return 0
}

if [ ! -f "$VOLUMES_FILE" ]; then
	exit 0
fi

while IFS=' ' read -r vol_name vol_serial vol_fs vol_mount; do
	[ -n "$vol_name" ] || continue

	if [ "$vol_fs" != "ext4" ]; then
		log "volume $vol_name: unsupported filesystem '$vol_fs', leaving $vol_mount alone"
		continue
	fi

	devname=$(find_device "$vol_serial") || {
		log "volume $vol_name: no disk found with serial '$vol_serial' for $vol_mount, skipping"
		continue
	}
	dev="/dev/$devname"
	if [ ! -b "$dev" ]; then
		log "volume $vol_name: $dev is not a block device, skipping $vol_mount"
		continue
	fi

	existing_label=$(ext4_label "$dev")
	if [ -n "$existing_label" ] && [ "$existing_label" = "$vol_name" ]; then
		# No reprobe needed here: the label was already there when this
		# script started, so udev's ordinary coldplug handling (see the
		# systemd unit's After=systemd-udev-trigger.service comment)
		# already covers it, the same as it does for every other disk
		# this script never touches.
		log "volume $vol_name: $dev is already ext4 labelled '$vol_name', reusing for $vol_mount"
		continue
	fi

	size=$(device_size_bytes "$devname") || {
		log "volume $vol_name: could not read the size of $dev, leaving $vol_mount alone"
		continue
	}

	if is_blank "$dev" "$size"; then
		if mkfs_out=$(mkfs.ext4 -F -L "$vol_name" "$dev" 2>&1); then
			log "volume $vol_name: $dev was blank, formatted ext4 (label $vol_name) for $vol_mount"
			reprobe_disk "$dev" "$vol_name"
			if noseed_contains "$vol_name"; then
				log "volume $vol_name: seed opted out, $vol_mount starts empty on $dev"
			else
				seed_volume "$dev" "$vol_mount" "$vol_name"
			fi
		else
			log "volume $vol_name: $dev was blank but mkfs.ext4 failed for $vol_mount: $mkfs_out"
		fi
	else
		log "volume $vol_name: $dev is neither blank nor ext4 labelled '$vol_name' (found label '${existing_label:-<none>}'); leaving $vol_mount alone"
	fi
done <"$VOLUMES_FILE"

exit 0
