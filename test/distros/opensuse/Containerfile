# Distribution test image: openSUSE (systemd, dracut). Parameterized by base
# image and extended with the in-guest boot check from ../common. Build
# with the context set to test/distros (hack/e2e.sh --distro does this).
ARG BASE=registry.opensuse.org/opensuse/tumbleweed:latest
FROM ${BASE}

LABEL io.contemper.ready="true"

ARG TARGETARCH

# kernel-default is the generic kernel flavour (the leaner kernel-kvmsmall
# lacks some drivers). Its scriptlets try to build an initrd for the
# build host, which a container build can't do meaningfully, so the
# initrd is generated explicitly below. systemd and udev are not part of
# the container image; --no-recommends keeps the install small.
RUN zypper --non-interactive install --no-recommends \
      kernel-default dracut systemd udev e2fsprogs kmod util-linux && \
    zypper clean --all

# dracut defaults to a host-only initrd, built for the machine running the
# build. --no-hostonly includes the generic storage drivers (virtio
# included) instead. A leftover initrd from the kernel package is replaced.
RUN kdirs="$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d)" && \
    kcount="$(printf '%s\n' "$kdirs" | grep -c .)" && \
    if [ "$kcount" -ne 1 ]; then \
      echo "test/distros/opensuse: expected exactly one directory under /usr/lib/modules, found $kcount: $kdirs" >&2; \
      exit 1; \
    fi && \
    kver="$(basename "$kdirs")" && \
    mkdir -p /boot/contemper && \
    dracut --no-hostonly --no-hostonly-cmdline --force --kver "$kver" /boot/contemper/initrd && \
    if [ -e "/usr/lib/modules/$kver/vmlinuz" ]; then \
      ln -sf "/usr/lib/modules/$kver/vmlinuz" /boot/contemper/vmlinuz; \
    else \
      ln -sf "../vmlinuz-$kver" /boot/contemper/vmlinuz; \
    fi

RUN case "$TARGETARCH" in \
      arm64) console=ttyAMA0 ;; \
      amd64) console=ttyS0 ;; \
      *) echo "test/distros/opensuse: unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac && \
    echo "rootfstype=ext4 rw console=${console}" >/boot/contemper/cmdline

RUN echo 'LABEL=contemper-root / ext4 rw,relatime 0 1' >>/etc/fstab

# Passwordless root.
RUN sed -i 's/^root:[^:]*:/root::/' /etc/shadow

# A first boot without locale/timezone/hostname makes systemd-firstboot
# prompt on the console; masking it keeps the boot unattended.
RUN ln -sf /dev/null /etc/systemd/system/systemd-firstboot.service

# Boot check and marker, run once systemd reaches multi-user.target.
COPY common/contemper-check.sh /usr/local/bin/contemper-check
COPY common/contemper-check.service /etc/systemd/system/contemper-check.service
RUN chmod 0755 /usr/local/bin/contemper-check && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf ../contemper-check.service /etc/systemd/system/multi-user.target.wants/contemper-check.service
